{
  // CAVEMAN NOTE: Python has no build step — the interpreter reads .py files directly.
  // TS is not "real" JS: it needs a compiler config (this file) so the editor and the
  // Playwright test-runner (which uses esbuild under the hood) know how to type-check
  // and transpile .ts -> .js before anything runs. Python's closest cousin to this file
  // is... nothing. Type hints in Python are optional and never block execution.
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "types": ["node", "@playwright/test"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
